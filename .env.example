# Environment Configuration Template — VoteIQ India
# Copy to .env and fill in your values

# ─── Required ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional (GCP Production) ────────────────────
# GCP_PROJECT=your-gcp-project-id
# ALLOWED_ORIGIN=https://your-domain.com

# ─── Flask ───────────────────────────────────────
SECRET_KEY=your-strong-random-secret-key-here
FLASK_ENV=development
PORT=8080

# ─── Notes ───────────────────────────────────────
# 1. Get Gemini API key from: https://aistudio.google.com/
# 2. For GCP deployment, set GCP_PROJECT and use Secret Manager
# 3. Never commit .env to git (it is in .gitignore)
